# -------------------------------------------------
# DysLexLens environment variables
# Copy this file to .env and replace the placeholder values.
# Do not commit your real .env file to GitHub.
# -------------------------------------------------

# OpenRouter API key used for LLM access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API base URL
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Query-time model used by the app
QUERY_LLM_MODEL=openai/gpt-4o-mini

# Fixed index model used when building the property graph index
FIXED_INDEX_LLM_MODEL=openai/gpt-4o-mini

# Embedding model used for the fixed index
FIXED_EMBED_MODEL=text-embedding-3-small

# Path to the fixed property graph index
FIXED_INDEX_DIR=index/fixed_property_graph_index

# Path where batch outputs are saved
SAVED_RUNS_DIR=saved_runs

# Path where combined evaluation outputs are saved
COMBINED_DIR=outputs/combined

# Optional: enable or disable graph screenshots
SAVE_GRAPH_SCREENSHOTS=false
